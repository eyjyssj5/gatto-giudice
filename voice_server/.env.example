# SOLO un modello di configurazione. NON aggiungere veri valori a GitHub.
# Genera un segreto casuale lungo almeno 32 caratteri; usalo anche in Cloudflare TTS_SECRET.
VOICE_SHARED_SECRET=INSERISCI_UN_SEGRETO_RANDOM_DI_ALMENO_32_CARATTERI
# Il token del tunnel si copia dal pannello Cloudflare Zero Trust, NON in chat.
CLOUDFLARE_TUNNEL_TOKEN=INSERISCI_TOKEN_CREATO_SU_CLOUDFLARE
